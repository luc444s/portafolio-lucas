{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shell": ["./vendor/shell/src/index.ts"],
      "@shell/*": ["./vendor/shell/src/*"],
      "@themes": ["./vendor/themes/src/index.ts"],
      "@themes/*": ["./vendor/themes/src/*"]
    }
  },
  "include": ["src"]
}
